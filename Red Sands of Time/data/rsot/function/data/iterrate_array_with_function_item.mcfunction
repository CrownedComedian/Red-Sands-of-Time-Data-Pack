# Recursively iterates through an array of data and runs a function for each item in the array

# Execute the function for the current item in the array
$function $(function) with storage rsot:iterration content[0]

data remove storage rsot:iterration content[0]

# Recurse
execute if data storage rsot:iterration content[0] run function rsot:data/iterrate_array_with_function_item with storage rsot:iterration